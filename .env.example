# Deployment settings read at build time by lib/site-url.ts.
# Copy to .env.local (or set in your hosting dashboard). Never commit real secrets.

# The portfolio's own domain, without a trailing slash. Drives canonical URLs,
# Open Graph URLs, the sitemap, and the Person JSON-LD url. Leave unset for
# local development and previews. Do not use bizmastersolutions.lk unless the
# portfolio is intentionally hosted there.
SITE_URL=

# Set to "true" on the production deployment only. Anything else keeps
# robots.txt at "Disallow: /" and adds noindex, so previews stay out of search.
ALLOW_INDEXING=
